# OpenAI
OPENAI_API_KEY=

# Qdrant Cloud
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=
COMPLIANCE_QDRANT_COLLECTION=compliance_knowledge_v1

# Models
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Retry and retrieval
MAX_RETRY_COUNT=2
TOP_K_PER_BRANCH=20
FINAL_TOP_N=5
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
MAX_CHUNK_CHARACTERS=1200
REVIEW_RETRIEVAL_LIMIT=5
REVIEW_MAX_MODEL_CALLS=8
REVIEW_MAX_TOTAL_TOOL_CALLS=40
REVIEW_MAX_KNOWLEDGE_SEARCH_CALLS=20
REVIEW_MAX_REFERENCE_CALLS=20
REVIEW_TIMEOUT_SECONDS=60

# Application
LOG_LEVEL=INFO
SYSTEM_ACCESS_SCOPE=local-system
DEPENDENCY_TIMEOUT_SECONDS=10

# Compose host ports - isolated from the source RAG checkout
BACKEND_HOST_PORT=18000
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
QDRANT_HOST_PORT=16333

# PostgreSQL - local development
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_only
DATABASE_URL=postgresql+psycopg://rag:rag_dev_only@postgres:5432/rag

# External MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
COMPLIANCE_MINIO_BUCKET=compliance-documents
MINIO_SECURE=false

# Async jobs
CELERY_BROKER_URL=redis://redis:6379/0
MAX_DOCUMENT_UPLOAD_BYTES=26214400
JOB_LEASE_SECONDS=360
JOB_MAX_ATTEMPTS=3
OUTBOX_LEASE_SECONDS=60
OUTBOX_BATCH_SIZE=50
JOB_MAINTENANCE_INTERVAL_SECONDS=2
CONTRACT_PROCESSING_TASK_TIMEOUT_SECONDS=300

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
